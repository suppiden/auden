---
import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
  base: string;
}

const { t, base } = Astro.props;
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  data-nav
>
  <nav
    class="max-w-8xl mx-auto px-6 md:px-10 h-16 flex items-center justify-between"
    aria-label="Main navigation"
    style="color: #fff; transition: color 0.3s ease;"
  >
    <a href={base} class="flex items-center" aria-label="Auden home" data-logo>
      <img src="/auden_isotipo_white.png" alt="Auden" class="nav-logo" style="height: 2.25rem; transition: height 0.4s cubic-bezier(0.16,1,0.3,1), filter 0.3s ease;" />
    </a>

    <ul class="hidden md:flex items-center gap-8 text-sm font-medium nav-links">
      <li><a href={`${base}#offer`} class="nav-link transition-colors pb-0.5">{t.nav.offer}</a></li>
      <li><a href={`${base}#packages`} class="nav-link transition-colors pb-0.5">{t.nav.about}</a></li>
      <li><a href={`${base}#work`} class="nav-link transition-colors pb-0.5">{t.nav.work}</a></li>
      <li><a href={`${base}#contact`} class="nav-link transition-colors pb-0.5">{t.nav.contact}</a></li>
    </ul>

    <div class="flex items-center gap-5">
      <a
        href={t.nav.langSwitchHref}
        class="text-xs font-medium tracking-widest uppercase hover:text-white transition-colors"
        style="color: rgba(255,255,255,0.6);"
        aria-label={`Switch to ${t.nav.langSwitch}`}
      >
        {t.nav.langSwitch}
      </a>

      <button
        class="flex items-center justify-center w-8 h-8 transition-colors"
        aria-label="Toggle theme"
        data-theme-toggle
      >
        <svg data-sun-icon class="hidden w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg data-moon-icon class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <a href={`${base}#contact`} class="hidden md:inline-flex items-center gap-2 px-5 py-2.5 text-xs font-medium tracking-wide border nav-contact-btn transition-colors duration-200">
        {t.nav.contact}
      </a>

      <button
        class="md:hidden flex flex-col gap-1.5 p-1"
        aria-label="Open menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="block w-5 h-px bg-current transition-all" data-line></span>
        <span class="block w-5 h-px bg-current transition-all" data-line></span>
      </button>
    </div>
  </nav>

  <div
    class="md:hidden hidden px-6 py-6 flex flex-col gap-6"
    style="background: #1A1A1A;"
    data-mobile-menu
  >
    <a href={`${base}#offer`} class="text-base font-medium text-white/80 hover:text-white transition-colors" data-mobile-link>{t.nav.offer}</a>
    <a href={`${base}#packages`} class="text-base font-medium text-white/80 hover:text-white transition-colors" data-mobile-link>{t.nav.about}</a>
    <a href={`${base}#work`} class="text-base font-medium text-white/80 hover:text-white transition-colors" data-mobile-link>{t.nav.work}</a>
    <a href={`${base}#contact`} class="text-base font-medium text-white/80 hover:text-white transition-colors" data-mobile-link>{t.nav.contact}</a>
    <a href={`${base}#contact`} class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white text-black text-sm font-medium tracking-wide hover:bg-white/90 transition-colors mt-2">{t.nav.contact}</a>
  </div>
</header>
