---
interface Props { lang: 'en' | 'es'; gaId?: string }
const { lang, gaId = 'G-N5EFP3ND70' } = Astro.props;

const t = lang === 'es'
  ? {
      msg: 'Usamos cookies de analítica (Google Analytics) para entender cómo se usa la web. Solo se activan si las aceptas.',
      accept: 'Aceptar',
      reject: 'Rechazar',
    }
  : {
      msg: 'We use analytics cookies (Google Analytics) to understand how the site is used. They load only if you accept.',
      accept: 'Accept',
      reject: 'Reject',
    };
---

<div id="cookie-banner" class="cc" hidden role="dialog" aria-label="Cookies">
  <p class="cc-msg">{t.msg}</p>
  <div class="cc-actions">
    <button id="cc-reject" class="cc-btn cc-btn--ghost" type="button">{t.reject}</button>
    <button id="cc-accept" class="cc-btn cc-btn--primary" type="button">{t.accept}</button>
  </div>
</div>

<style>
  .cc {
    position: fixed;
    left: 1rem; right: 1rem; bottom: 1rem;
    max-width: 34rem; margin: 0 auto; z-index: 90;
    background: #1A1A1A; color: #F5F4F0;
    border: 1px solid rgba(245,244,240,0.14);
    border-radius: 10px;
    padding: 1.15rem 1.25rem;
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.25rem;
    box-shadow: 0 18px 50px -18px rgba(0,0,0,0.55);
    font-family: inherit;
  }
  .cc[hidden] { display: none; }
  .cc-msg { margin: 0; font-size: 0.85rem; line-height: 1.55; flex: 1 1 16rem; color: rgba(245,244,240,0.82); }
  .cc-actions { display: flex; gap: 0.6rem; flex: 0 0 auto; }
  .cc-btn {
    font: inherit; font-size: 0.8rem; font-weight: 600; cursor: pointer;
    padding: 0.5rem 1.1rem; border-radius: 999px; border: 1px solid transparent;
    transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .cc-btn:hover { transform: translateY(-1px); }
  .cc-btn--primary { background: rgb(255,77,0); color: #111; }
  .cc-btn--ghost { background: transparent; color: #F5F4F0; border-color: rgba(245,244,240,0.35); }
  .cc-btn--ghost:hover { border-color: rgba(245,244,240,0.7); }
  :focus-visible { outline: 2px solid rgb(255,77,0); outline-offset: 2px; }
  @media (max-width: 480px) { .cc-actions { flex: 1 1 100%; } .cc-btn { flex: 1; } }
</style>

<script is:inline define:vars={{ gaId }}>
  (function () {
    var KEY = 'auden-cookie-consent';
    function loadGA() {
      if (window.__audenGA) return;
      window.__audenGA = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId);
    }
    var banner = document.getElementById('cookie-banner');
    function show() { if (banner) banner.hidden = false; }
    function hide() { if (banner) banner.hidden = true; }

    var choice = null;
    try { choice = localStorage.getItem(KEY); } catch (e) {}

    if (choice === 'granted') loadGA();
    else if (choice !== 'denied') show();

    document.getElementById('cc-accept')?.addEventListener('click', function () {
      try { localStorage.setItem(KEY, 'granted'); } catch (e) {}
      hide(); loadGA();
    });
    document.getElementById('cc-reject')?.addEventListener('click', function () {
      try { localStorage.setItem(KEY, 'denied'); } catch (e) {}
      hide();
    });
    // Let a footer link reopen the choice: <a href="#" onclick="audenCookieSettings()">
    window.audenCookieSettings = function () { show(); };
  })();
</script>
