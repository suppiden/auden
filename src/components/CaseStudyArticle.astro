---
import type { CollectionEntry } from 'astro:content';
import '../styles/case-study.css';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
  lang: 'en' | 'es';
}

const { entry, lang } = Astro.props;
const d = entry.data;
const base = lang === 'en' ? '/' : '/es/';
const workUrl = `${base}work/`;

const ytThumb = `https://img.youtube.com/vi/${d.videoId}/maxresdefault.jpg`;
const openLabel = lang === 'en' ? 'Open in SoundCloud →' : 'Abrir en SoundCloud →';

// Deterministic waveform heights for any audio facade.
const waveBars = Array.from({ length: 40 }, (_, i) =>
  22 + Math.round(Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.6)) * 76)
);

const BG_TOKENS: Record<string, string> = {
  default: 'cs-section--primary',
  alt: 'cs-section--alt',
  craft: 'cs-section--craft',
};

// Map a block's style props to a section class list + inline style.
function sectionClass(block: any, extra = '') {
  const s = block.style ?? {};
  const bg = s.bg ?? 'default';
  const token = BG_TOKENS[bg] ?? 'cs-section--primary';
  return ['cs-section', token, s.border ? 'cs-section--border' : '', extra]
    .filter(Boolean)
    .join(' ');
}
function sectionStyle(block: any) {
  const s = block.style ?? {};
  const out: string[] = [];
  if (s.bg && !BG_TOKENS[s.bg]) out.push(`background: ${s.bg}`);
  if (s.accent) out.push(`--cs-accent: ${s.accent}`);
  if (s.textColor) out.push(`--cs-text: ${s.textColor}`);
  return out.join('; ');
}
function scPlayerSrc(sc: { playlistId: string; secretToken?: string }) {
  const token = sc.secretToken ? `&secret_token=${sc.secretToken}` : '';
  return `https://w.soundcloud.com/player/?url=https%3A%2F%2Fapi.soundcloud.com%2Fplaylists%2F${sc.playlistId}${token}&color=%23ff4d00&auto_play=true&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false&visual=true`;
}
---

<article itemscope itemtype="https://schema.org/Article">

  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <header class="cs-hero">
    <div style="max-width: 64rem; margin: 0 auto;">
      <nav aria-label="Breadcrumb" style="margin-bottom: 3rem;" data-reveal>
        <a href={workUrl} class="cs-back-link" style="font-size: 0.7rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; text-decoration: none; transition: color 0.2s;">{d.backLabel[lang]}</a>
        <ol style="display: none;" aria-hidden="true">
          <li><a href={base}>Auden</a></li>
          <li><a href={workUrl}>{lang === 'en' ? 'Work' : 'Trabajo'}</a></li>
          <li aria-current="page">{d.title}</li>
        </ol>
      </nav>

      <p class="cs-eyebrow" data-reveal>{d.category} — {d.client}</p>
      <h1 itemprop="headline" class="cs-title" data-split-reveal>{d.title}</h1>
      <p itemprop="description" class="cs-dek" data-reveal>{d.dek[lang]}</p>
    </div>

    <div
      id="yt-facade"
      class="cs-video-wrap"
      role="button"
      tabindex="0"
      aria-label={`Play ${d.title}`}
      data-video-id={d.videoId}
      data-reveal
    >
      <img src={ytThumb} alt={`${d.title} — ${d.dek[lang]}`} loading="lazy" class="cs-video-thumb" />
      <div class="cs-video-overlay" aria-hidden="true"></div>
      <div class="cs-play-wrap" aria-hidden="true">
        <div class="cs-play-btn">
          <svg width="22" height="24" viewBox="0 0 22 24" fill="none" style="margin-left: 3px;">
            <path d="M2 2l18 10L2 22V2z" fill="#fff"/>
          </svg>
        </div>
      </div>
      {d.durationLabel && <span class="cs-duration">{d.durationLabel}</span>}
    </div>

    {d.jumpToScore && (
      <div class="cs-jump" data-reveal>
        <a href={`#${d.jumpToId}`} class="cs-jump-btn" data-scroll-to={d.jumpToId}>
          <span class="cs-jump-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M3 14V10M8 18V6M13 15V9M18 20V4M23 13v-2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
            </svg>
          </span>
          {(d.jumpLabel ?? d.dek)[lang]}
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    )}
  </header>

  <!-- ── BLOCKS ────────────────────────────────────────────────── -->
  {d.blocks.map((block) => {
    if (block.type === 'text') {
      const c = block.content[lang];
      return (
        <section class={sectionClass(block)} style={sectionStyle(block)} aria-label="Case study body">
          <div class="cs-prose" itemprop="articleBody">
            {c.paragraphs.map((group) => (
              <div style="margin-bottom: 2.5rem;" data-reveal>
                {group.map((p) => <p class="cs-body-p">{p}</p>)}
              </div>
            ))}
          </div>
        </section>
      );
    }

    if (block.type === 'quote') {
      const c = block.content[lang];
      return (
        <section class={sectionClass(block)} style={sectionStyle(block)} aria-label="Closing statement">
          <div style="max-width: 52rem; margin: 0 auto; text-align: center;">
            <blockquote style="margin: 0;" data-reveal>
              <p class="cs-closing-text">{c.statement}</p>
              {c.subline && <p class="cs-platform-line">{c.subline}</p>}
            </blockquote>
          </div>
        </section>
      );
    }

    if (block.type === 'numberedList') {
      const c = block.content[lang];
      return (
        <section class={sectionClass(block)} style={sectionStyle(block)} aria-labelledby={`${block.id}-heading`}>
          <div style="max-width: 56rem; margin: 0 auto;">
            <p id={`${block.id}-heading`} class="cs-section-eyebrow" style="margin-bottom: 3.5rem;" data-reveal>{c.label}</p>
            <ol class="cs-craft-list" data-reveal-stagger>
              {c.items.map((point, i) => (
                <li class="cs-craft-item">
                  <span class="cs-craft-num">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <strong class="cs-craft-heading">{point.heading}</strong>
                    <p class="cs-craft-body">{point.body}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </section>
      );
    }

    if (block.type === 'credits') {
      const c = block.content[lang];
      return (
        <section class={sectionClass(block)} style={sectionStyle(block)} aria-label="Credits">
          <div style="max-width: 56rem; margin: 0 auto;" data-reveal>
            <p class="cs-section-eyebrow" style="margin-bottom: 2rem;">{c.label}</p>
            <dl class="cs-credits-dl">
              {block.items.map((credit) => (
                <div>
                  <dt class="cs-credit-role">{credit.role}</dt>
                  <dd class="cs-credit-name">{credit.name}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      );
    }

    if (block.type === 'deliverables') {
      const c = block.content[lang];
      return (
        <section class={sectionClass(block)} style={sectionStyle(block)} aria-label="Deliverables">
          <div style="max-width: 56rem; margin: 0 auto;" data-reveal>
            <p class="cs-section-eyebrow" style="margin-bottom: 1.25rem;">{c.label}</p>
            <p class="cs-deliverables-text">{c.items}</p>
          </div>
        </section>
      );
    }

    if (block.type === 'audio') {
      const c = block.content[lang];
      const scSrc = block.soundcloud ? scPlayerSrc(block.soundcloud) : null;
      return (
        <section id={block.id} class={sectionClass(block)} style={sectionStyle(block)} aria-label="Score">
          <div style="max-width: 56rem; margin: 0 auto;" data-reveal>
            <p class="cs-section-eyebrow" style="margin-bottom: 1.25rem;">{c.title}</p>
            {scSrc ? (
              <>
                <div class="cs-audio">
                  <div id="sc-facade" class="cs-audio-facade" role="button" tabindex="0" aria-label={c.title} data-sc-src={scSrc}>
                    <div class="cs-audio-play" aria-hidden="true">
                      <svg width="18" height="20" viewBox="0 0 22 24" fill="none" style="margin-left: 2px;">
                        <path d="M2 2l18 10L2 22V2z" fill="#fff"/>
                      </svg>
                    </div>
                    <div class="cs-audio-meta">
                      <p class="cs-audio-title">{c.title}</p>
                      <p class="cs-audio-sub">{d.title} · SoundCloud</p>
                    </div>
                    <div class="cs-audio-wave" aria-hidden="true">
                      {waveBars.map((h) => <span style={`height: ${h}%`}></span>)}
                    </div>
                  </div>
                </div>
                {block.link && (
                  <a href={block.link} target="_blank" rel="noopener noreferrer" class="cs-score-link" style="margin-top: 1.5rem;">{openLabel}</a>
                )}
              </>
            ) : block.link ? (
              <a href={block.link} target="_blank" rel="noopener noreferrer" class="cs-score-link">{c.title}</a>
            ) : null}
          </div>
        </section>
      );
    }

    if (block.type === 'about') {
      const c = block.content[lang];
      return (
        <section class={sectionClass(block)} style={sectionStyle(block)} aria-label="About">
          <div style="max-width: 56rem; margin: 0 auto;" data-reveal>
            <p class="cs-about-label">{c.label}</p>
            <p class="cs-about-body">{c.body}</p>
          </div>
        </section>
      );
    }
    return null;
  })}

</article>


<script>
  // ── YouTube facade → inline player ───────────────────────────
  const facade = document.getElementById('yt-facade') as HTMLElement | null;
  if (facade) {
    function loadVideo() {
      const videoId = facade!.dataset.videoId;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1`;
      iframe.title = 'Case study video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'position: absolute; inset: 0; width: 100%; height: 100%; border: 0;';
      facade!.style.cursor = 'default';
      facade!.innerHTML = '';
      facade!.appendChild(iframe);
      facade!.removeEventListener('click', loadVideo);
      facade!.removeEventListener('keydown', keyHandler);
    }
    function keyHandler(e: KeyboardEvent) { if (e.key === 'Enter' || e.key === ' ') loadVideo(); }
    facade.addEventListener('click', loadVideo);
    facade.addEventListener('keydown', keyHandler);
  }

  // ── SoundCloud facade → inline player ────────────────────────
  const scFacade = document.getElementById('sc-facade') as HTMLElement | null;
  if (scFacade) {
    function loadAudio() {
      const src = scFacade!.dataset.scSrc;
      if (!src) return;
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = 'Score';
      iframe.width = '100%';
      iframe.height = '480';
      iframe.allow = 'autoplay';
      iframe.setAttribute('scrolling', 'no');
      iframe.setAttribute('frameborder', 'no');
      iframe.style.cssText = 'border: 0; display: block; width: 100%;';
      scFacade!.replaceWith(iframe);
    }
    function scKeyHandler(e: KeyboardEvent) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); loadAudio(); } }
    scFacade.addEventListener('click', loadAudio);
    scFacade.addEventListener('keydown', scKeyHandler);
  }

  // ── Smooth scroll for in-page jump buttons ───────────────────
  document.querySelectorAll<HTMLElement>('[data-scroll-to]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const id = btn.dataset.scrollTo;
      if (!id) return;
      document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
