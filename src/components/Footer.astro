---
import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<footer class="bg-cream overflow-hidden">
  <!-- Statement logo -->
  <div class="relative border-t border-border px-6 md:px-10 pt-20 pb-16 flex flex-col items-center justify-center text-center">
    <a
      href={t.lang === 'es' ? '/es/' : '/'}
      aria-label="Auden home"
      class="relative inline-block mb-6 group"
      data-logo
    >
      <img
        src="/auden_isotipo_white.png"
        alt="Auden"
        class="hidden dark:block transition-all duration-500 group-hover:opacity-70"
        style="height: clamp(3rem, 8vw, 5rem);"
      />
      <img
        src="/auden_isotipo_black.png"
        alt="Auden"
        class="block dark:hidden transition-all duration-500 group-hover:opacity-70"
        style="height: clamp(3rem, 8vw, 5rem);"
      />
    </a>

    <p class="text-xs text-mid tracking-[0.25em] uppercase">{t.footer.tagline}</p>

    <!-- Social icons -->
    <ul class="mt-10 flex items-center gap-6" aria-label="Social media">
      <li>
        <a
          href="https://www.instagram.com/auden.sonic"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="text-mid hover:text-charcoal transition-colors duration-200"
        >
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
      </li>
      <li>
        <a
          href="https://www.linkedin.com/company/audensonic/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="text-mid hover:text-charcoal transition-colors duration-200"
        >
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45C23.2 24 24 23.23 24 22.28V1.72C24 .77 23.2 0 22.22 0z"/>
          </svg>
        </a>
      </li>
      <li>
        <a
          href="https://www.youtube.com/@AudenStudio"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
          class="text-mid hover:text-charcoal transition-colors duration-200"
        >
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M23.5 6.2a3.02 3.02 0 0 0-2.13-2.13C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.37.57A3.02 3.02 0 0 0 .5 6.2C0 8.07 0 12 0 12s0 3.93.5 5.8a3.02 3.02 0 0 0 2.13 2.13c1.87.57 9.37.57 9.37.57s7.5 0 9.37-.57a3.02 3.02 0 0 0 2.13-2.13C24 15.93 24 12 24 12s0-3.93-.5-5.8zM9.6 15.6V8.4l6.27 3.6-6.27 3.6z"/>
          </svg>
        </a>
      </li>
    </ul>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-border px-6 md:px-10 py-5">
    <div class="max-w-8xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-mid">
      <span>{t.footer.rights}</span>
      <div class="flex items-center gap-4">
        <a
          href="mailto:hello@audensonic.com"
          class="nav-link hover:text-charcoal transition-colors pb-0.5"
        >
          hello@audensonic.com
        </a>
        <a
          href={t.nav.langSwitchHref}
          class="nav-link hover:text-charcoal transition-colors pb-0.5"
        >
          {t.nav.langSwitch}
        </a>
      </div>
    </div>
  </div>
</footer>
