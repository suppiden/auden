---
import '../styles/global.css';

interface Props {
  lang: 'en' | 'es';
  title: string;
  description: string;
  canonicalUrl: string;
  alternateUrl: string;
  ogImage?: string;
  jsonLd?: object;
}

const {
  lang,
  title,
  description,
  canonicalUrl,
  alternateUrl,
  ogImage = '/og-image.jpg',
  jsonLd,
} = Astro.props;

const alternateLang = lang === 'en' ? 'es' : 'en';
const ogImageAbsolute = `https://audensonic.com${ogImage}`;

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://audensonic.com/#org',
      name: 'Auden',
      url: 'https://audensonic.com',
      description: 'Sonic branding agency.',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Auden', item: 'https://audensonic.com' },
        { '@type': 'ListItem', position: 2, name: lang === 'en' ? 'Work' : 'Trabajo', item: `https://audensonic.com${lang === 'en' ? '/work/' : '/es/work/'}` },
        { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
      ],
    },
    ...(jsonLd ? [jsonLd] : []),
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonicalUrl : alternateUrl} />

    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:site_name" content="Auden" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <script type="application/ld+json" set:html={JSON.stringify(defaultJsonLd)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/auden_isotipo_white.png" as="image" />

    <!-- Google tag -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-N5EFP3ND70"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-N5EFP3ND70');
    </script>

    <script is:inline>
      const theme = localStorage.getItem('theme') ?? 'dark';
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <style is:global>
    /* ── Case study page tokens — flip with light/dark mode ── */
    :root {
      --cs-bg:           #F5F4F0;
      --cs-bg-alt:       #EDECEA;
      --cs-bg-craft:     #E8E7E3;
      --cs-yt-bg:        #D8D6D2;
      --cs-text:         #1A1A1A;
      --cs-text-body:    rgba(26,26,26,0.78);
      --cs-text-dim:     rgba(26,26,26,0.62);
      --cs-text-muted:   rgba(26,26,26,0.45);
      --cs-text-faint:   rgba(26,26,26,0.32);
      --cs-border:       rgba(26,26,26,0.09);
      --cs-border-strong:rgba(26,26,26,0.13);
    }
    .dark {
      --cs-bg:           #080808;
      --cs-bg-alt:       #0D0D0D;
      --cs-bg-craft:     #0F0F0F;
      --cs-yt-bg:        #111111;
      --cs-text:         #F0EFE9;
      --cs-text-body:    rgba(240,239,233,0.75);
      --cs-text-dim:     rgba(240,239,233,0.60);
      --cs-text-muted:   rgba(240,239,233,0.45);
      --cs-text-faint:   rgba(240,239,233,0.32);
      --cs-border:       rgba(240,239,233,0.08);
      --cs-border-strong:rgba(240,239,233,0.12);
    }
    .cs-back-link { color: var(--cs-text-muted); }
    .cs-back-link:hover { color: var(--cs-text); }

    /* ── Nav on inner pages — always dark glass, no video behind it ── */
    [data-nav] {
      background: rgba(0,0,0,0.80) !important;
      backdrop-filter: blur(12px) !important;
      -webkit-backdrop-filter: blur(12px) !important;
    }
    [data-nav] nav { color: #fff !important; }
    [data-nav] .nav-links { color: rgba(255,255,255,0.80) !important; }
    [data-nav] .nav-contact-btn { border-color: rgba(255,255,255,0.45) !important; color: #fff !important; }
    [data-nav] .nav-logo { filter: invert(0) !important; }
  </style>
  <body style="background: var(--cs-bg);">
    <div class="cursor-dot" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>

    <slot name="nav" />

    <div id="scroll-container">
      <slot />
    </div>

    <script>
      // ── Custom cursor ─────────────────────────────────────────────
      const dot  = document.querySelector('.cursor-dot')  as HTMLElement | null;
      const ring = document.querySelector('.cursor-ring') as HTMLElement | null;
      if (dot && ring) {
        let mx = window.innerWidth / 2, my = window.innerHeight / 2;
        let rx = mx, ry = my;
        document.addEventListener('mousemove', (e) => {
          mx = e.clientX; my = e.clientY;
          dot.style.left = mx + 'px'; dot.style.top = my + 'px';
        });
        (function tick() {
          rx += (mx - rx) * 0.1; ry += (my - ry) * 0.1;
          ring.style.left = rx + 'px'; ring.style.top = ry + 'px';
          requestAnimationFrame(tick);
        })();
        document.querySelectorAll('a, button').forEach(el => {
          el.addEventListener('mouseenter', () => document.body.classList.add('is-hovering'));
          el.addEventListener('mouseleave', () => document.body.classList.remove('is-hovering'));
        });
      }

      // ── Logo scale on scroll ─────────────────────────────────────
      const logoImgs = document.querySelectorAll<HTMLElement>('[data-logo] img');
      const nav      = document.querySelector('[data-nav]') as HTMLElement | null;
      const scroller = document.getElementById('scroll-container') as HTMLElement | null;
      scroller?.addEventListener('scroll', () => {
        const atTop = scroller.scrollTop < 20;
        logoImgs.forEach(img => { img.style.height = atTop ? '2.25rem' : '1.75rem'; });
        nav?.classList.toggle('is-scrolled', !atTop);
      }, { passive: true });

      // ── Scroll reveals ───────────────────────────────────────────
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        });
      }, { root: scroller, threshold: 0.08 });
      document.querySelectorAll('[data-reveal], [data-reveal-stagger], [data-reveal-text]').forEach(el => io.observe(el));

      // ── Split-word reveal ────────────────────────────────────────
      document.querySelectorAll<HTMLElement>('[data-split-reveal]').forEach(el => {
        const text = el.textContent?.trim() ?? '';
        const words = text.split(/\s+/);
        el.innerHTML = ''; el.setAttribute('aria-label', text);
        words.forEach((word, i) => {
          const mask = document.createElement('span');
          mask.style.cssText = 'display: inline-block; overflow: hidden; vertical-align: top;';
          const inner = document.createElement('span');
          inner.textContent = word;
          inner.style.cssText = `display: inline-block; transform: translateY(110%); transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: ${i * 0.05}s;`;
          inner.classList.add('split-word');
          mask.appendChild(inner); el.appendChild(mask);
          if (i < words.length - 1) el.appendChild(document.createTextNode(' '));
        });
      });
      const splitIO = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.querySelectorAll<HTMLElement>('.split-word').forEach(w => { w.style.transform = 'translateY(0)'; });
            splitIO.unobserve(e.target);
          }
        });
      }, { root: scroller, threshold: 0.1 });
      document.querySelectorAll('[data-split-reveal]').forEach(el => splitIO.observe(el));

      // ── Theme toggle (reused from Nav) ───────────────────────────
      const themeToggle = document.querySelector('[data-theme-toggle]') as HTMLButtonElement | null;
      const sunIcon  = document.querySelector('[data-sun-icon]')  as SVGElement | null;
      const moonIcon = document.querySelector('[data-moon-icon]') as SVGElement | null;
      function syncThemeIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        sunIcon?.classList.toggle('hidden', !isDark);
        moonIcon?.classList.toggle('hidden', isDark);
      }
      syncThemeIcons();
      themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        syncThemeIcons();
      });

      // ── Mobile nav toggle ────────────────────────────────────────
      const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
      const mobileMenu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
      const mobileLinks = document.querySelectorAll('[data-mobile-link]');
      toggle?.addEventListener('click', () => {
        if (!mobileMenu) return;
        const isOpen = mobileMenu.classList.contains('hidden');
        mobileMenu.classList.toggle('hidden', !isOpen);
        mobileMenu.classList.toggle('flex', isOpen);
        toggle.setAttribute('aria-expanded', String(isOpen));
      });
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu?.classList.add('hidden');
          mobileMenu?.classList.remove('flex');
          toggle?.setAttribute('aria-expanded', 'false');
        });
      });
    </script>
  </body>
</html>
