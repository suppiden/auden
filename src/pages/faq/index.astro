---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import InnerNav from '../../components/InnerNav.astro';
import Footer from '../../components/Footer.astro';
import Faq from '../../sections/Faq.astro';
import { getTranslations } from '../../i18n/utils';
import schema from '../../data/faq/faq-en.schema.json';

const t = getTranslations('en');
const SITE = 'https://audensonic.com';
const canonicalUrl = `${SITE}/faq/`;
const alternateUrl = `${SITE}/es/preguntas-frecuentes/`;

const title = 'Sonic Branding FAQ: Sonic Identity & Audio Logos | Auden';
const description =
  'What sonic branding is, what a sonic identity includes, how long it takes and how brand music is directed. Clear answers from Auden.';

// Reuse the site's existing Organization (#org) and WebSite (#website) ids;
// drop the delivered standalone Organization node (see LEEME-programador).
const jsonLd = [
  { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'Auden', publisher: { '@id': `${SITE}/#org` } },
  ...(schema['@graph'] as any[])
    .filter((n) => n['@type'] !== 'Organization')
    .map((n) =>
      n['@type'] === 'WebPage'
        ? { ...n, publisher: { '@id': `${SITE}/#org` }, isPartOf: { '@id': `${SITE}/#website` } }
        : n,
    ),
];
---

<CaseStudyLayout
  lang="en"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
  jsonLd={jsonLd}
  breadcrumbItems={null}
>
  <InnerNav t={t} base="/" langSwitchHref="/es/preguntas-frecuentes/" slot="nav" />

  <Faq lang="en" />

  <Footer t={t} langSwitchHref="/es/preguntas-frecuentes/" />
</CaseStudyLayout>
