---
export const prerender = false;

import { getSession } from 'auth-astro/server';

// Already signed in? Go straight to the dashboard. (Tolerate an unconfigured
// auth setup so the page still renders instead of 500-ing.)
let session = null;
try {
  session = await getSession(Astro.request);
} catch {
  session = null;
}
if (session?.user?.email) return Astro.redirect('/admin');

const error = Astro.url.searchParams.get('error');
const errorMsg =
  error === 'AccessDenied'
    ? 'Esa cuenta de Google no tiene acceso a este panel.'
    : error
      ? 'No se pudo iniciar sesión. Inténtalo de nuevo.'
      : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Auden Admin — Sign in</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <style>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        min-height: 100dvh; display: flex; align-items: center; justify-content: center;
        background: #080808; color: #F0EFE9; padding: 1.5rem;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      }
      .card {
        width: 100%; max-width: 24rem; text-align: center;
        border: 1px solid rgba(240,239,233,0.12); background: #0d0d0d;
        padding: 3rem 2rem; border-radius: 2px;
      }
      .mark { font-size: 2rem; font-weight: 900; letter-spacing: -0.02em; margin-bottom: 0.25rem; }
      .eyebrow { font-size: 0.65rem; letter-spacing: 0.25em; text-transform: uppercase; color: rgb(255,77,0); margin-bottom: 2.25rem; }
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
        width: 100%; padding: 0.85rem 1rem; cursor: pointer;
        background: #F0EFE9; color: #111; border: 0; border-radius: 999px;
        font-size: 0.85rem; font-weight: 600; letter-spacing: 0.02em;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }
      .btn:hover { transform: translateY(-1px); opacity: 0.92; }
      .err {
        margin-bottom: 1.5rem; padding: 0.7rem 0.9rem; border-radius: 2px;
        background: rgba(255,77,0,0.1); border: 1px solid rgba(255,77,0,0.35);
        color: #ffb599; font-size: 0.78rem; line-height: 1.5;
      }
      .foot { margin-top: 1.75rem; font-size: 0.7rem; color: rgba(240,239,233,0.4); }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="mark">Auden</div>
      <p class="eyebrow">Admin</p>
      {errorMsg && <div class="err">{errorMsg}</div>}
      <button id="google-signin" class="btn">
        <svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        Entrar con Google
      </button>
      <p class="foot">Acceso restringido · Auden Studio</p>
    </div>

    <script>
      import { signIn } from 'auth-astro/client';
      document.getElementById('google-signin')?.addEventListener('click', () => {
        signIn('google', { callbackUrl: '/admin' });
      });
    </script>
  </body>
</html>
