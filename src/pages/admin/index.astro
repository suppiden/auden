---
export const prerender = false;

import { getSession } from 'auth-astro/server';
import { getCollection } from 'astro:content';

// Middleware already guards this route; read the session for display.
const session = await getSession(Astro.request);
const email = session?.user?.email ?? '';

const entries = (await getCollection('caseStudies')).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Auden Admin — Case studies</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <style>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { min-height: 100dvh; background: #080808; color: #F0EFE9; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }
      header { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.75rem; border-bottom: 1px solid rgba(240,239,233,0.1); }
      .brand { font-weight: 900; letter-spacing: -0.02em; font-size: 1.1rem; }
      .brand span { color: rgb(255,77,0); font-weight: 500; font-size: 0.6rem; letter-spacing: 0.25em; text-transform: uppercase; margin-left: 0.5rem; }
      .who { display: flex; align-items: center; gap: 1rem; font-size: 0.78rem; color: rgba(240,239,233,0.55); }
      .guide-link { color: rgb(255,77,0); text-decoration: none; font-size: 0.78rem; font-weight: 600; }
      .guide-link:hover { text-decoration: underline; }
      .signout { background: none; border: 1px solid rgba(240,239,233,0.25); color: #F0EFE9; padding: 0.4rem 0.9rem; border-radius: 999px; font-size: 0.72rem; cursor: pointer; transition: border-color 0.2s; }
      .signout:hover { border-color: rgb(255,77,0); }
      main { max-width: 60rem; margin: 0 auto; padding: 3rem 1.75rem 5rem; }
      .row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 2.25rem; }
      h1 { font-size: 1.75rem; font-weight: 900; letter-spacing: -0.02em; }
      .new { background: rgb(255,77,0); color: #111; border: 0; padding: 0.65rem 1.2rem; border-radius: 999px; font-size: 0.78rem; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; transition: transform 0.2s; }
      .new:hover { transform: translateY(-1px); }
      .acts { display: flex; gap: 1.25rem; align-items: center; }
      .del-cs { background: none; border: 0; color: rgba(240,239,233,0.4); font: inherit; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; padding: 0; transition: color 0.2s; }
      .del-cs:hover:not(:disabled) { color: #ff6b6b; }
      .del-cs:disabled { opacity: 0.5; cursor: default; }
      .toast { position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%); background: #1c1b18; border: 1px solid rgba(240,239,233,0.14); border-left: 3px solid rgb(255,77,0); padding: 0.75rem 1.15rem; border-radius: 6px; font-size: 0.82rem; box-shadow: 0 10px 30px rgba(0,0,0,0.5); z-index: 50; max-width: 90vw; }
      .list { display: flex; flex-direction: column; gap: 1px; background: rgba(240,239,233,0.1); border: 1px solid rgba(240,239,233,0.1); }
      .item { display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: center; background: #0d0d0d; padding: 1.1rem 1.4rem; }
      .item h2 { font-size: 1rem; font-weight: 700; }
      .item .meta { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(240,239,233,0.4); margin-top: 0.25rem; }
      .item a { color: rgb(255,77,0); font-size: 0.75rem; text-decoration: none; letter-spacing: 0.08em; text-transform: uppercase; }
      .note { margin-top: 2rem; font-size: 0.78rem; color: rgba(240,239,233,0.4); line-height: 1.6; }
    </style>
  </head>
  <body>
    <header>
      <div class="brand">Auden <span>Admin</span></div>
      <div class="who">
        <a href="/admin/guia" class="guide-link">Guía</a>
        <span>{email}</span>
        <button id="signout" class="signout">Cerrar sesión</button>
      </div>
    </header>

    <main>
      <div class="row">
        <h1>Case studies</h1>
        <a class="new" href="/admin/new">+ Nuevo case study</a>
      </div>

      <div class="list">
        {entries.map((entry) => (
          <div class="item">
            <div>
              <h2>{entry.data.title}</h2>
              <p class="meta">{entry.data.category} — {entry.data.client} · {entry.data.blocks.length} bloques{entry.data.draft ? ' · borrador' : ''}</p>
            </div>
            <span class="acts">
              <a href={`/admin/edit/${entry.id}`}>Editar</a>
              <a href={`/work/${entry.id}/`} target="_blank" rel="noopener">Ver →</a>
              <button class="del-cs" data-slug={entry.id} data-title={entry.data.title}>Eliminar</button>
            </span>
          </div>
        ))}
      </div>

      <p class="note">
        Sesión iniciada. Haz clic en un case study para editarlo, o en «+ Nuevo case study» para crear uno.
        Al publicar, el cambio se guarda en la web y se redespliega solo (~1–2 min).
      </p>
    </main>

    <script>
      import { signOut } from 'auth-astro/client';
      document.getElementById('signout')?.addEventListener('click', () => {
        signOut({ callbackUrl: '/admin/login' });
      });

      function toast(msg: string) {
        const el = document.createElement('div');
        el.className = 'toast';
        el.textContent = msg;
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 6000);
      }

      document.querySelectorAll<HTMLButtonElement>('.del-cs').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const slug = btn.dataset.slug!;
          const title = btn.dataset.title || slug;
          if (!confirm(`¿Eliminar «${title}»?\n\nSe quita de la web. Esta acción no se puede deshacer desde el panel.`)) return;
          btn.disabled = true;
          btn.textContent = 'Eliminando…';
          try {
            const res = await fetch('/api/admin/delete', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ slug }),
            });
            const json = await res.json();
            if (!res.ok) throw new Error(json.message || 'Error');
            // Remove the row for immediate feedback (the live site rebuilds in ~1–2 min).
            btn.closest('.item')?.remove();
            toast('Eliminado. La web se actualiza en ~1–2 min.');
          } catch (e: any) {
            alert('No se pudo eliminar: ' + e.message);
            btn.disabled = false;
            btn.textContent = 'Eliminar';
          }
        });
      });
    </script>
  </body>
</html>
