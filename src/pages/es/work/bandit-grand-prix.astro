---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import InnerNav from '../../../components/InnerNav.astro';
import Footer from '../../../components/Footer.astro';
import { getTranslations } from '../../../i18n/utils';
import { getCaseStudy } from '../../../data/caseStudies';

const t = getTranslations('es');
const cs = getCaseStudy('bandit-grand-prix')!;
const c = cs.content.es;

const canonicalUrl = 'https://audensonic.com/es/work/bandit-grand-prix/';
const alternateUrl = 'https://audensonic.com/work/bandit-grand-prix/';

const jsonLd = {
  '@type': 'Article',
  '@id': `${canonicalUrl}#article`,
  headline: c.metaTitle,
  description: c.metaDescription,
  url: canonicalUrl,
  inLanguage: 'es',
  author: { '@id': 'https://audensonic.com/#org' },
  publisher: { '@id': 'https://audensonic.com/#org' },
  about: {
    '@type': 'CreativeWork',
    name: cs.title,
    description: c.dek,
    creator: { '@type': 'Organization', name: 'Auden' },
    contributor: { '@type': 'Person', name: 'Anjelica Florendo' },
    genre: 'Sonic Branding',
    keywords: 'sonic branding, audio branding, diseno sonoro, score electronico, Bandit, running',
  },
};

const ytThumb = `https://img.youtube.com/vi/${cs.videoId}/maxresdefault.jpg`;
---

<CaseStudyLayout
  lang="es"
  title={c.metaTitle}
  description={c.metaDescription}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
  jsonLd={jsonLd}
>
  <InnerNav t={t} base="/es/" slot="nav" />

  <main id="main-content">
    <article itemscope itemtype="https://schema.org/Article">

      <header class="cs-hero">
        <div style="max-width: 64rem; margin: 0 auto;">

          <nav aria-label="Migas de pan" style="margin-bottom: 3rem;" data-reveal>
            <a href="/es/work/" class="cs-back-link" style="font-size: 0.7rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; text-decoration: none; transition: color 0.2s;">{c.backLabel}</a>
            <ol style="display: none;" aria-hidden="true">
              <li><a href="/es/">Auden</a></li>
              <li><a href="/es/work/">Trabajo</a></li>
              <li aria-current="page">{cs.title}</li>
            </ol>
          </nav>

          <p class="cs-eyebrow" data-reveal>{cs.category} — {cs.client}</p>
          <h1 itemprop="headline" class="cs-title" data-split-reveal>{cs.title}</h1>
          <p itemprop="description" class="cs-dek" data-reveal>{c.dek}</p>
        </div>

        <div
          id="yt-facade"
          class="cs-video-wrap"
          role="button"
          tabindex="0"
          aria-label={`Reproducir ${cs.title}`}
          data-video-id={cs.videoId}
          data-reveal
        >
          <img src={ytThumb} alt={`${cs.title} — ${c.dek}`} loading="lazy" class="cs-video-thumb" />
          <div class="cs-video-overlay" aria-hidden="true"></div>
          <div class="cs-play-wrap" aria-hidden="true">
            <div class="cs-play-btn">
              <svg width="22" height="24" viewBox="0 0 22 24" fill="none" style="margin-left: 3px;">
                <path d="M2 2l18 10L2 22V2z" fill="#fff"/>
              </svg>
            </div>
          </div>
          <span class="cs-duration">0:45</span>
        </div>
      </header>

      <section class="cs-section cs-section--primary" aria-label="Cuerpo del case study">
        <div class="cs-prose" itemprop="articleBody">
          {c.body.map((paragraphs) => (
            <div style="margin-bottom: 2.5rem;" data-reveal>
              {paragraphs.map((p) => (
                <p class="cs-body-p">{p}</p>
              ))}
            </div>
          ))}
        </div>
      </section>

      <section class="cs-section cs-section--alt cs-section--border" aria-label="Cierre">
        <div style="max-width: 52rem; margin: 0 auto; text-align: center;">
          <blockquote style="margin: 0;" data-reveal>
            <p class="cs-closing-text">{c.closing}</p>
            <p class="cs-platform-line">{c.platformLine}</p>
          </blockquote>
        </div>
      </section>

      <section class="cs-section cs-section--craft cs-section--border" aria-labelledby="craft-heading">
        <div style="max-width: 56rem; margin: 0 auto;">
          <p id="craft-heading" class="cs-section-eyebrow" style="margin-bottom: 3.5rem;" data-reveal>{c.craftLabel}</p>
          <ol class="cs-craft-list" data-reveal-stagger>
            {c.craft.map((point, i) => (
              <li class="cs-craft-item">
                <span class="cs-craft-num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <strong class="cs-craft-heading">{point.heading}</strong>
                  <p class="cs-craft-body">{point.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="cs-section cs-section--primary cs-section--border" aria-label="Creditos y entregables">
        <div style="max-width: 56rem; margin: 0 auto; display: flex; flex-direction: column; gap: 5rem;">

          <div data-reveal>
            <p class="cs-section-eyebrow" style="margin-bottom: 2rem;">{c.creditsLabel}</p>
            <dl class="cs-credits-dl">
              {cs.credits.map((credit) => (
                <div>
                  <dt class="cs-credit-role">{credit.role}</dt>
                  <dd class="cs-credit-name">{credit.name}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div data-reveal class="cs-sub-block">
            <p class="cs-section-eyebrow" style="margin-bottom: 1.25rem;">{c.deliverablesLabel}</p>
            <p class="cs-deliverables-text">{c.deliverableItems}</p>
            {cs.deliverableLink ? (
              <a href={cs.deliverableLink} target="_blank" rel="noopener noreferrer" class="cs-score-link">{c.deliverableCta}</a>
            ) : (
              <span class="cs-score-link cs-score-link--disabled">{c.deliverableCta}</span>
            )}
          </div>

          <div data-reveal class="cs-sub-block">
            <p class="cs-about-label">{c.aboutLabel}</p>
            <p class="cs-about-body">{c.aboutBody}</p>
          </div>

        </div>
      </section>

    </article>
  </main>

  <Footer t={t} />
</CaseStudyLayout>

<style>
  .cs-hero { background: var(--cs-bg); padding: 9rem 1.5rem 4rem; text-align: center; }
  .cs-section { padding: 6rem 1.5rem; }
  .cs-section--primary { background: var(--cs-bg); }
  .cs-section--alt { background: var(--cs-bg-alt); padding-top: 5rem; padding-bottom: 6rem; }
  .cs-section--craft { background: var(--cs-bg-craft); }
  .cs-section--border { border-top: 1px solid var(--cs-border); }
  .cs-eyebrow { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: rgb(255,77,0); margin-bottom: 1.5rem; }
  .cs-title { font-size: clamp(3rem, 10vw, 8rem); font-weight: 900; line-height: 0.95; letter-spacing: -0.03em; color: var(--cs-text); margin: 0 0 2rem; text-transform: uppercase; }
  .cs-dek { font-size: clamp(1rem, 2.5vw, 1.375rem); font-weight: 400; line-height: 1.6; color: var(--cs-text-dim); max-width: 42rem; margin: 0 auto 4rem; }
  .cs-video-wrap { max-width: 56rem; margin: 0 auto; position: relative; aspect-ratio: 16/9; background: var(--cs-yt-bg); overflow: hidden; cursor: pointer; }
  .cs-video-thumb { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease, opacity 0.4s ease; }
  .cs-video-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 60%); pointer-events: none; }
  .cs-play-wrap { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
  .cs-play-btn { width: 5rem; height: 5rem; border-radius: 50%; background: rgba(255,77,0,0.9); display: flex; align-items: center; justify-content: center; transition: transform 0.3s ease, background 0.3s ease; box-shadow: 0 0 60px rgba(255,77,0,0.4); }
  .cs-video-wrap:hover .cs-video-thumb { transform: scale(1.03); opacity: 0.85; }
  .cs-video-wrap:hover .cs-play-btn { transform: scale(1.1); background: rgb(255,77,0); }
  .cs-duration { position: absolute; bottom: 1rem; right: 1rem; background: rgba(0,0,0,0.75); color: #fff; font-size: 0.7rem; font-weight: 500; letter-spacing: 0.05em; padding: 0.25rem 0.5rem; backdrop-filter: blur(4px); }
  .cs-prose { max-width: 42rem; margin: 0 auto; }
  .cs-body-p { font-size: clamp(1rem, 1.5vw, 1.125rem); line-height: 1.85; color: var(--cs-text-body); margin: 0 0 1.25rem; }
  .cs-closing-text { font-size: clamp(1.25rem, 3.5vw, 2.25rem); font-weight: 900; line-height: 1.2; letter-spacing: -0.02em; color: var(--cs-text); margin: 0 0 1.5rem; text-transform: uppercase; }
  .cs-platform-line { font-size: 0.85rem; font-weight: 500; letter-spacing: 0.15em; color: rgb(255,77,0); text-transform: uppercase; margin: 0; }
  .cs-section-eyebrow { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: rgb(255,77,0); margin: 0; }
  .cs-craft-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .cs-craft-item { padding: 2.5rem 0; border-top: 1px solid var(--cs-border-strong); display: grid; grid-template-columns: 3rem 1fr; gap: 2rem; align-items: start; }
  .cs-craft-num { font-size: 0.75rem; font-weight: 500; color: var(--cs-text-faint); padding-top: 0.35rem; font-variant-numeric: tabular-nums; }
  .cs-craft-heading { display: block; font-size: 1rem; font-weight: 700; color: var(--cs-text); margin-bottom: 0.75rem; letter-spacing: -0.01em; }
  .cs-craft-body { font-size: 0.95rem; line-height: 1.8; color: var(--cs-text-dim); margin: 0; }
  .cs-credits-dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.5rem 2.5rem; }
  .cs-credit-role { font-size: 0.65rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: var(--cs-text-faint); margin-bottom: 0.35rem; }
  .cs-credit-name { font-size: 0.9rem; font-weight: 500; color: var(--cs-text); margin: 0; }
  .cs-sub-block { border-top: 1px solid var(--cs-border-strong); padding-top: 3rem; }
  .cs-deliverables-text { font-size: 0.9rem; color: var(--cs-text-dim); margin: 0 0 1.5rem; line-height: 1.6; }
  .cs-score-link { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(255,77,0); text-decoration: none; border-bottom: 1px solid rgba(255,77,0,0.4); padding-bottom: 0.15rem; }
  .cs-score-link--disabled { color: rgba(255,77,0,0.4); cursor: default; }
  .cs-about-label { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--cs-text-faint); margin: 0 0 0.75rem; }
  .cs-about-body { font-size: 0.85rem; line-height: 1.75; color: var(--cs-text-muted); margin: 0; }
</style>

<script>
  const facade = document.getElementById('yt-facade') as HTMLElement | null;
  if (facade) {
    function loadVideo() {
      const videoId = facade!.dataset.videoId;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1`;
      iframe.title = 'Bandit Grand Prix';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'position: absolute; inset: 0; width: 100%; height: 100%; border: 0;';
      facade!.style.cursor = 'default';
      facade!.innerHTML = '';
      facade!.appendChild(iframe);
      facade!.removeEventListener('click', loadVideo);
      facade!.removeEventListener('keydown', keyHandler);
    }
    function keyHandler(e: KeyboardEvent) { if (e.key === 'Enter' || e.key === ' ') loadVideo(); }
    facade.addEventListener('click', loadVideo);
    facade.addEventListener('keydown', keyHandler);
  }
</script>
