---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import InnerNav from '../../../components/InnerNav.astro';
import Footer from '../../../components/Footer.astro';
import { getTranslations } from '../../../i18n/utils';
import { caseStudies } from '../../../data/caseStudies';

const t = getTranslations('es');
const canonicalUrl = 'https://audensonic.com/es/work/';
const alternateUrl = 'https://audensonic.com/work/';

const title = 'Trabajo — Case Studies de Sonic Branding | Auden';
const description = 'Trabajo seleccionado de Auden — sonic branding, diseño sonoro y scores originales para marcas y films.';
---

<CaseStudyLayout
  lang="es"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
>
  <InnerNav t={t} base="/es/" slot="nav" />

  <main id="main-content">
    <section class="wl-section">
      <div style="max-width: 72rem; margin: 0 auto;">

        <header style="margin-bottom: 5rem;" data-reveal>
          <p class="wl-eyebrow">Trabajo seleccionado</p>
          <h1 class="wl-headline">Identidad<br>en práctica.</h1>
        </header>

        <div class="wl-grid" data-reveal-stagger>
          {caseStudies.map((cs) => {
            const c = cs.content.es;
            const ytThumb = `https://img.youtube.com/vi/${cs.videoId}/maxresdefault.jpg`;
            return (
              <a href={`/es/work/${cs.slug}/`} class="wl-card">
                <div class="wl-thumb-wrap">
                  <img src={ytThumb} alt={cs.title} loading="lazy" class="wl-thumb" />
                  <div class="wl-thumb-overlay" aria-hidden="true"></div>
                  <div class="wl-thumb-meta">
                    <p class="wl-thumb-eyebrow">{cs.category} — {cs.client}</p>
                    <h2 class="wl-thumb-title">{cs.title}</h2>
                  </div>
                </div>
                <div class="wl-card-body">
                  <p class="wl-card-dek">{c.dek}</p>
                  <span class="wl-card-cta">Leer case study →</span>
                </div>
              </a>
            );
          })}
        </div>

      </div>
    </section>
  </main>

  <Footer t={t} />
</CaseStudyLayout>

<style>
  .wl-section { background: var(--cs-bg); min-height: 100dvh; padding: 9rem 1.5rem 8rem; }
  .wl-eyebrow { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: rgb(255,77,0); margin: 0 0 1.25rem; }
  .wl-headline { font-size: clamp(2.5rem, 8vw, 6rem); font-weight: 900; line-height: 1; letter-spacing: -0.03em; color: var(--cs-text); margin: 0; text-transform: uppercase; }
  .wl-grid { display: grid; grid-template-columns: 1fr; gap: 2px; background: var(--cs-border); }
  .wl-card { display: grid; background: var(--cs-bg); text-decoration: none; transition: background 0.3s; }
  .wl-card:hover { background: var(--cs-bg-alt); }
  .wl-thumb-wrap { position: relative; aspect-ratio: 16/9; overflow: hidden; background: var(--cs-yt-bg); }
  .wl-thumb { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(0.16,1,0.3,1), opacity 0.4s ease; }
  .wl-card:hover .wl-thumb { transform: scale(1.04); opacity: 0.85; }
  .wl-thumb-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 55%); pointer-events: none; }
  .wl-thumb-meta { position: absolute; bottom: 1.5rem; left: 1.5rem; }
  .wl-thumb-eyebrow { font-size: 0.65rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: rgb(255,77,0); margin: 0 0 0.4rem; }
  .wl-thumb-title { font-size: clamp(1.5rem, 4vw, 2.5rem); font-weight: 900; color: #F0EFE9; margin: 0; letter-spacing: -0.02em; text-transform: uppercase; }
  .wl-card-body { padding: 1.75rem 1.5rem; border-top: 1px solid var(--cs-border); }
  .wl-card-dek { font-size: 0.9rem; line-height: 1.7; color: var(--cs-text-dim); margin: 0 0 1.25rem; max-width: 48rem; }
  .wl-card-cta { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: rgb(255,77,0); }
</style>
