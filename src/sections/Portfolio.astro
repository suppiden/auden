---
import type { Translations } from '../i18n/en';
import { portfolio, type PortfolioCategory } from '../data/portfolio';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const VISIBLE = 3;
const categoryOrder: PortfolioCategory[] = ['studio', 'concept', 'postProduction'];
const categories = categoryOrder.filter((cat) => portfolio.some((item) => item.category === cat));
const defaultCategory: PortfolioCategory = categories[0] ?? 'studio';
const hasWork = portfolio.length > 0;
---

<section
  id="work"
  class="py-28 md:py-36 px-6 md:px-10"
  style="background: #000;"
  aria-labelledby="work-headline"
>
  <div class="max-w-8xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-10 md:mb-14">
      <div>
        <p
          class="text-[10px] font-medium tracking-[0.25em] uppercase mb-5"
          style="color: rgba(255,255,255,0.45);"
          data-reveal
        >{t.work.eyebrow}</p>
        <h2
          id="work-headline"
          class="text-4xl md:text-5xl lg:text-6xl font-black leading-[1.05] tracking-tight uppercase"
          style="color: #F0EFE9;"
          data-split-reveal
        >{t.work.headline}</h2>
      </div>
      <a
        href={t.lang === 'es' ? '/es/work/' : '/work/'}
        class="flex-shrink-0 self-end"
        style="font-size: 0.7rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.45); text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.2); padding-bottom: 0.2rem; transition: color 0.2s, border-color 0.2s;"
        onmouseover="this.style.color='#F0EFE9'; this.style.borderColor='rgba(240,239,233,0.6)'"
        onmouseout="this.style.color='rgba(255,255,255,0.45)'; this.style.borderColor='rgba(255,255,255,0.2)'"
        data-reveal
      >{t.lang === 'es' ? 'Case studies →' : 'Case studies →'}</a>
    </div>

    {hasWork ? (
      <>
        <!-- Category tabs -->
        <div
          class="flex flex-wrap items-center gap-2 md:gap-3 mb-12 md:mb-16"
          role="tablist"
          aria-label="Portfolio categories"
        >
          {categories.map((cat) => (
            <button
              type="button"
              role="tab"
              data-portfolio-tab={cat}
              aria-selected={cat === defaultCategory}
              class:list={[
                'px-5 py-2.5 text-xs font-medium tracking-[0.15em] uppercase border transition-colors duration-200',
                cat === defaultCategory ? 'portfolio-tab--active' : 'portfolio-tab--inactive',
              ]}
            >
              {t.work.categories[cat]}
            </button>
          ))}
        </div>

        <!-- Items per category — only the active panel is visible -->
        {categories.map((cat) => {
          const items = portfolio.filter((item) => item.category === cat);
          const isVertical = items[0]?.aspect === 'vertical';
          const needsCarousel = items.length > VISIBLE;
          const gridClass = isVertical
            ? 'grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 md:gap-10 max-w-4xl mx-auto'
            : 'grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10';
          const aspectClass = isVertical ? 'aspect-[9/16]' : 'aspect-video';
          return (
            <div
              role="tabpanel"
              data-portfolio-panel={cat}
              hidden={cat !== defaultCategory}
            >
              <div
                class="relative"
                data-carousel
                data-carousel-len={items.length}
                data-carousel-visible={VISIBLE}
              >
                <div class={gridClass} data-carousel-track>
                  {items.map((item, i) => (
                    <article
                      data-carousel-item
                      data-index={i}
                      hidden={needsCarousel && i >= VISIBLE}
                      style={`order: ${i};`}
                      class="group"
                    >
                      {item.videoUrl ? (
                        <div
                          class={`relative w-full ${aspectClass} mb-6 overflow-hidden rounded-sm`}
                          style="background: #0d0d0d; border: 1px solid rgba(255,255,255,0.08);"
                        >
                          <iframe
                            src={`${item.videoUrl}?rel=0&modestbranding=1&playsinline=1`}
                            title={item.client}
                            class="absolute inset-0 w-full h-full"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                            loading="lazy"
                          />
                        </div>
                      ) : item.cover ? (
                        <a
                          href={item.caseStudyUrl ?? '#work'}
                          class="block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
                          style="outline-color: #F0EFE9;"
                          aria-label={`${item.client} — ${t.work.categories[item.category]}`}
                        >
                          <img
                            src={item.cover}
                            alt={item.client}
                            class={`w-full ${aspectClass} object-cover mb-6 grayscale group-hover:grayscale-0 transition-all duration-500 rounded-sm`}
                            loading="lazy"
                          />
                        </a>
                      ) : (
                        <div
                          class={`w-full ${aspectClass} mb-6 flex items-center justify-center rounded-sm`}
                          style="background: rgba(255,255,255,0.05);"
                          aria-hidden="true"
                        >
                          <span class="text-xs tracking-[0.2em] uppercase" style="color: rgba(255,255,255,0.4);">Visual TBC</span>
                        </div>
                      )}
                      <p
                        class="text-[10px] font-medium tracking-[0.2em] uppercase mb-2"
                        style="color: rgba(255,255,255,0.45);"
                      >
                        {t.work.categories[item.category]}
                      </p>
                      <h3 class="text-lg font-serif mb-1" style="color: #F0EFE9;">{item.client}</h3>
                      <p class="text-sm leading-relaxed mb-3" style="color: rgba(255,255,255,0.6);">{item.description}</p>
                      {item.caseStudyUrl && (
                        <a
                          href={t.lang === 'es' ? item.caseStudyUrl.replace('/work/', '/es/work/') : item.caseStudyUrl}
                          style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.65rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: rgb(255,77,0); text-decoration: none; border-bottom: 1px solid rgba(255,77,0,0.35); padding-bottom: 0.1rem; transition: border-color 0.2s;"
                        >Case study →</a>
                      )}
                    </article>
                  ))}
                </div>

                {needsCarousel && (
                  <div class="flex items-center justify-center gap-4 mt-12">
                    <button
                      type="button"
                      data-carousel-prev
                      aria-label="Previous"
                      class="portfolio-carousel-btn"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                        <polyline points="15 18 9 12 15 6"/>
                      </svg>
                    </button>
                    <button
                      type="button"
                      data-carousel-next
                      aria-label="Next"
                      class="portfolio-carousel-btn"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                        <polyline points="9 18 15 12 9 6"/>
                      </svg>
                    </button>
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </>
    ) : (
      <div
        class="p-16 md:p-24 flex flex-col items-center justify-center text-center gap-6"
        style="border: 1px solid rgba(255,255,255,0.15);"
      >
        <p class="text-sm" style="color: rgba(255,255,255,0.6);">{t.work.empty}</p>
      </div>
    )}
  </div>
</section>

<script>
  // ── Tabs ──────────────────────────────────────────────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-portfolio-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-portfolio-panel]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.portfolioTab;
      if (!target) return;

      tabs.forEach((t) => {
        const isActive = t.dataset.portfolioTab === target;
        t.setAttribute('aria-selected', String(isActive));
        t.classList.toggle('portfolio-tab--active', isActive);
        t.classList.toggle('portfolio-tab--inactive', !isActive);
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.portfolioPanel !== target;
      });
    });
  });

  // ── Carousel — sliding window of N visible items, circular ───────
  const carousels = document.querySelectorAll<HTMLElement>('[data-carousel]');

  carousels.forEach((carousel) => {
    const total = parseInt(carousel.dataset.carouselLen || '0', 10);
    const visible = parseInt(carousel.dataset.carouselVisible || '3', 10);
    if (total <= visible) return;

    const items = carousel.querySelectorAll<HTMLElement>('[data-carousel-item]');
    let start = 0;

    function render() {
      const visibleSet = new Set<number>();
      for (let i = 0; i < visible; i++) {
        visibleSet.add((start + i) % total);
      }
      items.forEach((item) => {
        const idx = parseInt(item.dataset.index || '0', 10);
        const isVisible = visibleSet.has(idx);
        item.hidden = !isVisible;
        if (isVisible) {
          const offset = (idx - start + total) % total;
          item.style.order = String(offset);
        }
      });
    }

    carousel.querySelector('[data-carousel-prev]')?.addEventListener('click', () => {
      start = (start - visible + total) % total;
      render();
    });
    carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => {
      start = (start + visible) % total;
      render();
    });
  });
</script>
