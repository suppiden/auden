---
import type { Translations } from '../i18n/en';
import { portfolio, type PortfolioCategory } from '../data/portfolio';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const categoryOrder: PortfolioCategory[] = ['concept', 'postProduction', 'studio'];
const categories = categoryOrder.filter((cat) => portfolio.some((item) => item.category === cat));
const defaultCategory: PortfolioCategory = categories[0] ?? 'concept';
const hasWork = portfolio.length > 0;
---

<section id="work" class="py-28 md:py-36 px-6 md:px-10 bg-cream border-t border-border" aria-labelledby="work-headline">
  <div class="max-w-8xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-10 md:mb-14">
      <div>
        <p class="section-eyebrow mb-5" data-reveal>{t.work.eyebrow}</p>
        <h2 id="work-headline" class="section-headline uppercase" data-split-reveal>{t.work.headline}</h2>
      </div>
    </div>

    {hasWork ? (
      <>
        <!-- Category tabs -->
        <div
          class="flex flex-wrap items-center gap-2 md:gap-3 mb-12 md:mb-16"
          role="tablist"
          aria-label="Portfolio categories"
          data-portfolio-tabs
        >
          {categories.map((cat) => (
            <button
              type="button"
              role="tab"
              data-portfolio-tab={cat}
              aria-selected={cat === defaultCategory}
              class:list={[
                'portfolio-tab px-5 py-2.5 text-xs font-medium tracking-[0.15em] uppercase border transition-colors duration-200',
                cat === defaultCategory
                  ? 'bg-charcoal text-cream border-charcoal'
                  : 'bg-transparent text-charcoal border-border hover:border-charcoal',
              ]}
            >
              {t.work.categories[cat]}
            </button>
          ))}
        </div>

        <!-- Items per category — only the active panel is visible -->
        {categories.map((cat) => {
          const items = portfolio.filter((item) => item.category === cat);
          const isVertical = items[0]?.aspect === 'vertical';
          const gridClass = isVertical
            ? 'grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 md:gap-10 max-w-4xl mx-auto'
            : 'grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10';
          const aspectClass = isVertical ? 'aspect-[9/16]' : 'aspect-video';
          return (
            <div
              role="tabpanel"
              data-portfolio-panel={cat}
              hidden={cat !== defaultCategory}
            >
              <div class={gridClass}>
                {items.map((item) => (
                  <article class="group">
                    {item.videoUrl ? (
                      <div class={`relative w-full ${aspectClass} mb-6 overflow-hidden rounded-sm border border-border/30 bg-charcoal`}>
                        <iframe
                          src={`${item.videoUrl}?rel=0&modestbranding=1&playsinline=1`}
                          title={item.client}
                          class="absolute inset-0 w-full h-full"
                          frameborder="0"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                          allowfullscreen
                          loading="lazy"
                        />
                      </div>
                    ) : item.cover ? (
                      <a
                        href={item.caseStudyUrl ?? '#work'}
                        class="block focus-visible:outline focus-visible:outline-2 focus-visible:outline-charcoal"
                        aria-label={`${item.client} — ${t.work.categories[item.category]}`}
                      >
                        <img
                          src={item.cover}
                          alt={item.client}
                          class={`w-full ${aspectClass} object-cover mb-6 grayscale group-hover:grayscale-0 transition-all duration-500 rounded-sm`}
                          loading="lazy"
                        />
                      </a>
                    ) : (
                      <div
                        class={`w-full ${aspectClass} bg-border mb-6 flex items-center justify-center rounded-sm`}
                        aria-hidden="true"
                      >
                        <span class="text-xs tracking-[0.2em] uppercase text-mid">Visual TBC</span>
                      </div>
                    )}
                    <p class="text-[10px] font-medium tracking-[0.2em] uppercase text-mid mb-2">
                      {t.work.categories[item.category]} · {item.year}
                    </p>
                    <h3 class="text-lg font-serif text-charcoal mb-1">{item.client}</h3>
                    <p class="text-sm text-mid leading-relaxed">{item.description}</p>
                  </article>
                ))}
              </div>
            </div>
          );
        })}
      </>
    ) : (
      <div class="border border-border p-16 md:p-24 flex flex-col items-center justify-center text-center gap-6">
        <p class="text-sm text-mid">{t.work.empty}</p>
      </div>
    )}
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-portfolio-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-portfolio-panel]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.portfolioTab;
      if (!target) return;

      tabs.forEach((t) => {
        const isActive = t.dataset.portfolioTab === target;
        t.setAttribute('aria-selected', String(isActive));
        t.classList.toggle('bg-charcoal', isActive);
        t.classList.toggle('text-cream', isActive);
        t.classList.toggle('border-charcoal', isActive);
        t.classList.toggle('bg-transparent', !isActive);
        t.classList.toggle('text-charcoal', !isActive);
        t.classList.toggle('border-border', !isActive);
        t.classList.toggle('hover:border-charcoal', !isActive);
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.portfolioPanel !== target;
      });
    });
  });
</script>
